# Virtual Graph Demo: environment configuration
#
# Copy this file to `.env` and fill in the values, then run the demos.
#
#   cp .env.sample .env
#
# The NEO4J_* values are read by connection.py at demo runtime and are all the core
# demos need. The DATABRICKS_* and VG_* values below are optional. Only
# `--demo 100m` reads them, and only with the history extra installed
# (`uv sync --extra history`). The lakehouse setup notebook
# (notebooks/01_setup_lakehouse.ipynb) runs inside Databricks and is configured in its
# own configuration cell, so it needs nothing from this file.
#
# PROBE_ENV is not set in this file: it is read from the shell before any dotenv is
# loaded and points the demos at a different dotenv, for example
#   PROBE_ENV=~/other.env uv run vg-probe "RETURN 1 AS ok"

# ── Neo4j Aura (Virtual Graph engine) ─────────────────────────────────
NEO4J_URI=neo4j+s://<instance>.graph-engine.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# ── Databricks (optional, only `--demo 100m`) ──────────────────────────
# Databricks CLI / SDK profile from ~/.databrickscfg. Falls back to DATABRICKS_PROFILE,
# then DEFAULT. `--profile` overrides it.
# DATABRICKS_CONFIG_PROFILE=<profile-name>
# Unity Catalog location of `account_links_large` and `accounts`. Fall back to CATALOG
# and SCHEMA, then to the defaults shown.
# DATABRICKS_CATALOG=virtual-graph-dbx
# DATABRICKS_SCHEMA=vg-schema
# SQL warehouse the 100m demo runs on: the one behind the Virtual Graph, where
# `account_links_large` lives. Defaults to the id shown. `--warehouse` overrides it.
# DATABRICKS_WAREHOUSE_ID is not used for this.
# VG_BACKING_WAREHOUSE_ID=b0fffb8e3255bf85
