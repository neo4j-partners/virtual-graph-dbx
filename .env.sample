# Virtual Graph Demo — environment configuration
#
# Copy this file to `.env` and fill in the values, then run the demos.
#
#   cp .env.sample .env
#
# Only the NEO4J_* values are read, by connection.py at demo runtime. The lakehouse
# setup notebook (notebooks/01_setup_lakehouse.ipynb) runs inside Databricks and is
# configured in its own configuration cell, so it needs nothing from this file.

# ── Neo4j Aura (Virtual Graph engine) ─────────────────────────────────
NEO4J_URI=neo4j+s://<instance>.graph-engine.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
